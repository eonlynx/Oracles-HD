ghost_0 {...la casa...}{...portami...}{...la casa...}{...alla baia...}
// trying to enter a dungon
ghost_1 {...N-N-No!...}{...N-no la!}
ghost_2 {...Here!...}{...entra...}{...casa mia...}
ghost_3 {...Nostalgia...}{...immutata...}{...boo hoo...}
ghost_4 {...Abbastanza...}{...cimitero...}{...portami...}{...la tomba...}
ghost_5 {...my grave...}{...take me...}{...my grave...}
